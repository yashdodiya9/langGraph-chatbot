# Copy this file to .env and fill in real values. Never commit the real .env.

# --- LLM ---------------------------------------------------------------
# ChatGroq reads GROQ_API_KEY from the environment automatically.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_groq_model_name

# --- Tools ---------------------------------------------------------------
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key

# --- RAG (PDF upload) ------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=150

# --- Storage ---------------------------------------------------------------
# Leave unset to use ./data/chatbot.db. Tests override this automatically.
# DB_PATH=./data/chatbot.db

# --- MCP servers (optional) -------------------------------------------------
# Off by default - see app/backend/tools/mcp_tools.py for caveats before enabling.
ENABLE_MCP_TOOLS=false
MCP_ARITH_SERVER_PATH=./mcp_servers/arith_server.py
MCP_EXPENSE_SERVER_URL=https://splendid-gold-dingo.fastmcp.app/mcp